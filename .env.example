# ==============================
# Manhua-Bot Configuration
# ==============================

# Telegram API (https://my.telegram.org)
API_ID=
API_HASH=

# Bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://manhua:password@localhost:5432/manhua_bot

# Your Telegram User ID (get from @userinfobot) - space separated for multiple
OWNER_ID=

# Log Group/Channel ID (optional, set 0 to disable)
LOG_GROUP=0

# Force Subscribe Channels (optional, space-separated IDs or usernames)
# Example: FSUB_CHANNELS=@chan1 @chan2 -100123456789
FSUB_CHANNELS=

# Default output type for chapters: pdf | cbz | links
DEFAULT_FTYPE=pdf

# Discord or generic webhook URL (optional)
WEBHOOK_URL=

# Album mode max pages (0 = disabled). Chapters with <= N pages sent as media group
ALBUM_MAX_PAGES=10

# Post a 1-5 rate poll after chapter posts (1/0)
ENABLE_RATE_POLL=0
